# Copy to .env for local docker compose. On Railway / Render / Fly, set these
# in the platform "Variables" or "Secrets" UI — never commit real values.

# Required for chat (and for RUN_INGEST_ON_START if you enable it).
MISTRAL_API_KEY=

# MongoDB Atlas SRV URI including database name, e.g.:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/giulia?retryWrites=true&w=majority
MONGODB_URI=

MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest
RAG_TOP_K=8

# Optional container behaviour (see README).
# RUN_INGEST_ON_START=0
# REBUILD_FAISS_ON_START=0
