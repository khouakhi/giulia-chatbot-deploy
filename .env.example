# Copy to .env for local docker compose. On Render, set these in the service
# "Environment" panel — never commit real values.

# Required for chat (and for RUN_INGEST_ON_START if you enable it).
MISTRAL_API_KEY=

# MongoDB Atlas SRV URI including database name, e.g.:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/giulia?retryWrites=true&w=majority
#
# MONGODB_URI must include the database path before "?" (required by PyMongo).
# Wrong: ...mongodb.net/?retryWrites=...
# Right: ...mongodb.net/giulia?retryWrites=...
#
# Same database holds: chunks, documents, and (when logging is on) giulia_conversations.
MONGODB_URI=

MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest
RAG_TOP_K=8

# MMR retrieval (defaults match upstream Giulia-Chatbot).
RAG_MMR_ENABLED=true
RAG_MMR_LAMBDA=0.58
RAG_MMR_FETCH_MULT=3
RAG_MMR_FETCH_CAP=40

# Chat logging: each question/answer stored in giulia_conversations (default: on).
# LOG_CONVERSATIONS=true

# Optional container behaviour (see README).
# RUN_INGEST_ON_START=0
# REBUILD_FAISS_ON_START=0
